# Copy to .env (or set these in the Combell Node.js app environment)

# Password for the admin login page
ADMIN_PASSWORD=change-me

# Secret used to sign session cookies. Set a long random value in production
# so logins survive server restarts.
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server listens on. On Combell/Passenger this is provided automatically.
PORT=3000

# ---------------------------------------------------------------------------
# Database (persistent storage that survives container rebuilds/redeploys).
# If these are NOT set, the app falls back to local file storage (data/ +
# public/uploads), which is fine for local development but is wiped on
# rebuild by container-based hosts like Combell's Node.js platform.
#
# Use the MySQL database from your Combell "Databases" section:
DB_HOST=your-db-host.combell.com
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Alternatively, a single connection string can be used instead of the DB_* vars:
# DATABASE_URL=mysql://user:password@host:3306/dbname
