# Copy to .env (or set these in the Combell Node.js app environment)

# Password for the admin login page
ADMIN_PASSWORD=change-me

# Secret used to sign session cookies. Set a long random value in production
# so logins survive server restarts.
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server listens on. On Combell/Passenger this is provided automatically.
PORT=3000
